{
  "name": "learning_japanese",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "flashcards:build": "node scripts/build_flashcards.mjs",
    "novel:audio": "node scripts/prepare_novel_audio.mjs && python scripts/build_novel_audio.py",
    "novel:build": "python scripts/build_novel.py && node scripts/audit_novel.mjs",
    "novel:audit": "node scripts/audit_novel.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "kuromoji": "^0.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
