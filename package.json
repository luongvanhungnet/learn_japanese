{
  "name": "learning_japanese",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "flashcards:build": "node scripts/build_flashcards.mjs",
    "novel:audio": "node scripts/prepare_novel_audio.mjs && python scripts/build_novel_audio.py",
    "novel:build": "python scripts/build_novel.py && node scripts/audit_novel.mjs",
    "novel:audit": "node scripts/audit_novel.mjs",
    "dev": "concurrently --kill-others-on-fail -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "db:local": "node scripts/local_database.mjs",
    "db:migrate": "tsx server/migrate.ts",
    "test:db": "node --import tsx scripts/check_account_database.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "speed-exam:audit": "node scripts/audit_speed_exam.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "kuromoji": "^0.1.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
