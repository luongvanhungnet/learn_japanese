# Copy this file to .env.local and fill in your database credentials.
# npm run db:local generates a separate local PostgreSQL database and secrets.
DATABASE_URL=postgresql://mimikara_app:replace_with_password@127.0.0.1:5433/mimikara_study
# Generate a long random value. Never prefix server secrets with VITE_.
SESSION_SECRET=replace_with_at_least_32_random_characters
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3001,http://127.0.0.1:3001
PORT=3001
# NODE_ENV=production
# For a remote database that requires TLS:
# DATABASE_SSL=true
# Optional certificate authority PEM path, with verification enabled:
# DATABASE_SSL_CA_FILE=/absolute/path/to/ca.pem
